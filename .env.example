# Copy to .env and fill in. Never commit .env or key files.
TIC_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
TIC_CONTACT_EMAIL=tic-crawler@example.com
# gcs://bucket/prefix or a local path. Drive is never allowed here.
TIC_RAW_STORE=./raw
# Optional overrides
# TIC_CONFIG=config.toml
# TIC_STATE_DB=state/tic.sqlite
# TIC_OUTPUT_DIR=out
